# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a key, a password or a connection string in here.

# Which backend the client talks to:
#   false            = the real Express API at VITE_API_BASE_URL (the full app)
#   unset or true    = demo mode: a simulated backend inside the browser,
#                      with a visible "Demo mode" notice
# Only the exact value "false" turns demo mode off.
VITE_USE_MOCK_API=false

# Where the Express API lives. Ignored in demo mode. No trailing slash.
#   Local:     http://localhost:3000
#   Deployed:  https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:3000
