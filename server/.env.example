# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local PostgreSQL (see README "Database setup"):
#   postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/cologger
# Hosted (e.g. Neon):
#   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/cologger

# Browser origins allowed to call the API. Comma-separated, no trailing slash,
# no path. An origin is scheme + host + port.
#   Local Vite dev server:  http://localhost:5173
#   GitHub Pages:           https://yourusername.github.io
CORS_ORIGINS=http://localhost:5173

# Set to production on your host (hides stack traces, trusts the host's proxy
# so rate limiting sees real visitor IPs).
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
